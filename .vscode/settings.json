{
    // ============================================================
    // 项目级 VS Code 设置
    // 作用：只对这个项目生效（保存在 .vscode/settings.json）
    // ============================================================
    // Rust 格式化使用 rustfmt（rust-analyzer 默认的格式化器）
    // 由于我们用了 nightly 才支持的 brace_style（大括号换行），
    // 必须指定 nightly 工具链的 rustfmt
    "rust-analyzer.rustfmt.overrideCommand": [
        "cargo",
        "+nightly",
        "fmt",
        "--"
    ],
    // 保存文件时自动格式化
    "editor.formatOnSave": true,
    // 把 Rust 文件默认格式化器设为 rust-analyzer
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    // 使用 rust-analyzer 时 rustfmt 额外配置
    "rust-analyzer.checkOnSave": {
        "command": "clippy"
    }
}